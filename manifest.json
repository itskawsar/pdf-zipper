{
  "manifest_version": 3,
  "name": "PDF Tabs to ZIP",
  "version": "1.1.0",
  "description": "Download all PDF files open in your tabs as a single ZIP.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Download open PDFs as ZIP",
    "default_popup": "popup.html"
  }
}
